  "item": [
    {
      "name": "Login",
      "item": [
        {
          "name": "Auth - CreateToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// 1. Converte o corpo da resposta para um objeto JSON que o Postman entende\r",
                  "const resposta = pm.response.json();\r",
                  "\r",
                  "// 2. Pega o valor que está dentro do campo \"token\"\r",
                  "const meuToken = resposta.token;\r",
                  "\r",
                  "// 3. Salva esse valor na variável de ambiente que você criou\r",
                  "pm.environment.set(\"TOKEN\", meuToken);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{BASE_URL}}/auth",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "auth"
              ]
            },
            "description": "Generated from cURL: curl -X POST \\\r\n  https://restful-booker.herokuapp.com/auth \\\r\n  -H 'Content-Type: application/json' \\\r\n  -d '{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}'"
          },
          "response": []
        }
      ]
